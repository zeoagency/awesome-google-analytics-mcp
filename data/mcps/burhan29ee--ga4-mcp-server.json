          },
          "event_name": {
            "type": "string",
            "title": "Event Name"
          },
          "params": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Params",
            "default": null
          },
          "validate": {
            "type": "boolean",
            "title": "Validate",
