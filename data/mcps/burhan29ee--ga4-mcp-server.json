        }
      ],
      "behavior": "POSTs one event with arbitrary params and client_id to the Measurement Protocol collect endpoint, or debug endpoint when validate is true. Returns HTTP status and parsed/text response; HTTPError returns status and error text.",
      "scope": "ga4",
